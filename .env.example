# ─── Banco de dados ────────────────────────────────────────────────────────────
# Use 'sqlite' para zero configuração ou 'pgsql' para PostgreSQL
DB_DRIVER=sqlite

# SQLite: caminho relativo à raiz do projeto
DB_SQLITE_PATH=data/hidro.sqlite

# PostgreSQL (ignorado se DB_DRIVER=sqlite)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hidro
DB_USER=postgres
DB_PASS=

# ─── Cotas de inundação (metros) ───────────────────────────────────────────────
# Ajuste conforme referências oficiais da Defesa Civil
COTA_INUNDACAO_LAJEADO=23.00
COTA_INUNDACAO_MUCUM=15.00
COTA_INUNDACAO_ENCANTADO=18.00

# ─── Limiares de evento ────────────────────────────────────────────────────────
# Chuva acumulada (mm) em janela de 6h para ABRIR um evento
LIMIAR_CHUVA_ABERTURA_MM=15.0

# Horas sem chuva significativa para FECHAR um evento
LIMIAR_FECHAMENTO_H=12

# Mínimo de horas que um evento deve ter para ser considerado válido no cálculo
MIN_HORAS_EVENTO=18

# ─── HTTP / Coleta ─────────────────────────────────────────────────────────────
SGB_BASE_URL=https://www.sgb.gov.br/sace/sace_nivel/api/dados/
SGB_TIMEOUT=30

# ─── Logs ──────────────────────────────────────────────────────────────────────
LOG_PATH=logs/hidro.log
LOG_LEVEL=info
